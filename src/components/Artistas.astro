---
import data from '../content/glock.json';
const firstLink = (a: { ig: string; tiktok: string; yt: string }) => a.ig || a.tiktok || a.yt || '';
---
<section id="artistas" class="border-y border-white/10 bg-[#120312]">
  <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <h2 class="font-display h-display uppercase">Pasaron<br />por Glock</h2>
    <ul class="mt-8 flex flex-wrap gap-x-2 gap-y-5 md:gap-x-3">
      {data.artistas.map((a) => {
        const href = firstLink(a);
        return (
          <li>
            {href ? (
              <a class="tag" href={href} target="_blank" rel="noopener">{a.nombre}</a>
            ) : (
              <span class="tag">{a.nombre}</span>
            )}
          </li>
        );
      })}
    </ul>
    <p class="mt-8 text-white/60">¿Sos artista y querés tu link acá? Escribinos por WhatsApp.</p>
  </div>
</section>
