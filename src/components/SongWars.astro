---
import data from '../content/glock.json';
---
<section id="songwars" class="bg-[#4B0055]">
  <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <h2 class="font-display h-display uppercase">Song-<br />wars</h2>
    <p class="mt-4 max-w-2xl text-lg">Competencia virtual de GLOCK: cada artista presenta su canción, un jurado evalúa con puntaje y los ganadores se llevan premios.</p>
    {data.songwars.map((s) => (
      <article class="mt-10 grid gap-8 md:grid-cols-12">
        <div class="md:col-span-5">
          <div class="grid max-w-md place-items-center bg-[#0A0A0A] md:rotate-1">
            <span class="col-start-1 row-start-1 p-4 text-center font-display text-4xl font-bold uppercase">Songwars vol.{s.vol}</span>
            <img src={s.flyer} alt={s.flyerAlt} loading="lazy" width="800" height="1000" class="col-start-1 row-start-1 h-auto w-full object-cover" onerror="this.remove()" />
          </div>
        </div>
        <div class="md:col-span-7">
          <h3 class="font-display uppercase leading-none" style="font-size: clamp(2rem, 6vw, 4rem);">Songwars vol.{s.vol}. {s.fecha} {s.hora}hs</h3>
          <p class="mt-2 text-lg">En vivo por {s.plataforma}. {s.formato}</p>
          <p class="mt-4 font-display text-2xl uppercase">Premio. {s.premio}</p>
          <a href={s.url} target="_blank" rel="noopener" class="btn-ghost btn-giant mt-6">Ver en Kick</a>
        </div>
      </article>
    ))}
  </div>
</section>
