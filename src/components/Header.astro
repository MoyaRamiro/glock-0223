---
import data from '../content/glock.json';
const links = [
  { href: '#ediciones', label: 'Ediciones' },
  { href: '#artistas', label: 'Artistas' },
  { href: '#sessions', label: 'Sessions' },
  { href: '#contacto', label: 'Contacto' },
];
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0A0A0A]">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3" aria-label="Principal">
    <a href="#top" class="shrink-0" aria-label="GLOCK. volver arriba">
      <img src="/images/logo/logo-circulo.png" alt="GLOCK" width="128" height="128" class="h-16 w-16 object-contain" />
    </a>
    <div class="hidden gap-7 md:flex">
      {links.map((l) => (
        <a href={l.href} class="font-display text-lg font-bold uppercase tracking-wide transition-colors hover:text-[#C400FF]">{l.label}</a>
      ))}
    </div>
    <a href={data.contacto.instagram} target="_blank" rel="noopener" class="btn-glock" aria-label="Seguir a GLOCK en Instagram">
      <span class="inline-flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" x2="17.51" y1="6.5" y2="6.5" /></svg>
        <span>Seguir</span>
      </span>
    </a>
  </nav>
</header>
