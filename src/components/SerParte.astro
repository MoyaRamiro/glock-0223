---
import { wa } from '../utils/seo';
const vias = [
  { t: 'Soy artista', d: 'Mostrate en el cypher o en los shows.', href: wa('Quiero mostrarme en GLOCK, soy [aka] y hago [trap/rap/freestyle]') },
  { t: 'Soy marca', d: 'Sponsors y emprendimientos.', href: wa('Quiero sponsorear GLOCK, soy [marca]') },
  { t: 'Tengo espacio', d: 'Espacios culturales y nocturnos.', href: wa('Tengo un espacio para GLOCK en [zona]') },
];
---
<section id="ser-parte" class="mx-auto max-w-6xl px-4 py-14 md:py-20">
  <h2 class="font-display h-display uppercase">Ser parte<br />de Glock</h2>
  <div class="mt-8 border-b border-white/15">
    {vias.map((v) => (
      <a href={v.href} target="_blank" rel="noopener" class="row-link flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-white/15 px-2 py-5 md:py-6">
        <span class="font-display text-4xl uppercase md:text-6xl">{v.t}</span>
        <span class="text-white/60">{v.d}</span>
      </a>
    ))}
  </div>
  <p class="mt-6 text-white/60">O escribinos a <a class="underline underline-offset-4" href="mailto:glock08000@gmail.com">glock08000@gmail.com</a></p>
</section>
