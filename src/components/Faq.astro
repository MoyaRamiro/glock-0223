---
import { data } from '../data';
---
<section id="faq" class="mx-auto max-w-6xl px-4 py-14 md:py-20" data-reveal-scope>
  <h2 class="font-display h-display uppercase" data-reveal="lead" data-misalign>Preguntas<br />frecuentes</h2>
  <div class="mt-8">
    {data.faq.map((f) => (
      <details class="border-t border-white/15 py-4 last:border-b">
        <summary class="cursor-pointer font-display text-3xl uppercase md:text-4xl">{f.q}</summary>
        <p class="mt-2 max-w-3xl text-lg text-white/75">{f.a}</p>
      </details>
    ))}
  </div>
</section>
